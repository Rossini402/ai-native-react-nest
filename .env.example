# Runtime environment: development | test | production
NODE_ENV=development
PORT=3001

# Persistence adapter: "memory" (zero-Docker fast dev/tests) | "postgres" (Drizzle + PostgreSQL)
STORAGE_MODE=memory
DATABASE_URL=postgresql://app:app_dev_password@localhost:5432/ai_stage_dev

# Authentication (must be >= 32 random chars in production)
JWT_SECRET=dev-only-jwt-secret-change-in-production-32chars
JWT_EXPIRES_IN_SECONDS=28800
